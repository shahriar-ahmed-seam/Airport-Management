<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Admin Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p5.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .dashboard-header {
            text-align: center;
            color: #ffffff;
            font-size: 36px;
            margin-top: 40px;
            margin-bottom: 30px;
            font-weight: bold;
        }

        .management-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 30px;
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px;
        }

        .management-card {
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 25px 20px;
            text-align: center;
            cursor: pointer;
            transition: transform 0.3s, background 0.3s, box-shadow 0.3s;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .management-card:hover {
            transform: translateY(-8px);
            background: rgba(0, 0, 0, 0.85);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
            border-color: #F3C693;
        }

        .management-card img {
            width: 130px;
            height: 130px;
            object-fit: contain;
            margin-bottom: 15px;
            transition: transform 0.3s;
        }

        .management-card:hover img {
            transform: scale(1.08);
        }

        .management-card .desc {
            color: #ffffff;
            font-size: 22px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About & Contact</a></li>
                    <li><a href='/admin'>Admin Profile</a></li>
                    <li><a href='/logout'>Log Out</a></li>
                </ul>
            </nav>
        </div>

        <h1 class="dashboard-header">Admin Management Portal</h1>

        <div class="management-grid">
            <div class="management-card" onclick="window.location.href='/money';">
                <img src="/images/cash.png" alt="Money Overview">
                <div class="desc">Money</div>
            </div>
            
            <div class="management-card" onclick="window.location.href='/search';">
                <img src="/images/search.png" alt="Plane Search">
                <div class="desc">Search a Plane</div>
            </div>
            
            <div class="management-card" onclick="window.location.href='/employee';">
                <img src="/images/employee.png" alt="Employees List">
                <div class="desc">Employees</div>
            </div>
            
            <div class="management-card" onclick="window.location.href='/airport';">
                <img src="/images/airport.png" alt="Airports Info">
                <div class="desc">Other Airports</div>
            </div>        
        </div>
    </div>
</body>
</html>