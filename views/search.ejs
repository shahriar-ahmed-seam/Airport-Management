<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Flight Finder</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body, html {
            overflow-x: hidden;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p7.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
            overflow-x: hidden;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .page-title {
            margin: 30px 0 20px 0;
            font-size: 38px;
            text-align: center;
            color: #F3C693;
            font-weight: bold;
        }

        .search-container {
            max-width: 480px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .search-card {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .form-group label {
            display: block;
            color: #F3C693;
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-group input {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font-size: 16px;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-group input:focus {
            border-color: #F3C693;
        }

        .search-btn {
            width: 100%;
            padding: 12px 0;
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
        }

        .search-btn:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
        }

        #flightInfo {
            display: none;
            margin-top: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(243, 198, 147, 0.4);
            border-radius: 8px;
            color: #F3C693;
            font-size: 20px;
            text-align: center;
            font-weight: bold;
        }

        .plane-wrapper {
            position: relative;
            width: 100%;
            height: 120px;
            overflow: hidden;
            margin-top: 30px;
        }

        .plane {
            position: absolute;
            animation: flyAcross 12s linear infinite;
        }

        .plane img {
            width: 120px;
        }

        @keyframes flyAcross {
            0% {
                left: -150px;
                transform: scaleX(1);
            }
            49% {
                left: calc(100% + 50px);
                transform: scaleX(1);
            }
            50% {
                left: calc(100% + 50px);
                transform: scaleX(-1);
            }
            99% {
                left: -150px;
                transform: scaleX(-1);
            }
            100% {
                left: -150px;
                transform: scaleX(1);
            }
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About Us</a></li>
                    <li><a href='/contact'>Contact</a></li>
                </ul>
            </nav>
        </div>

        <h1 class="page-title">Flight Finder</h1>

        <div class="search-container">
            <div class="search-card">
                <form id="flightForm">
                    <div class="form-group">
                        <label for="flightNumber">Flight Number:</label>
                        <input type="text" id="flightNumber" name="flightNumber" placeholder="e.g. 101, 102" required>
                    </div>

                    <div class="form-group">
                        <label for="timeRange">Time / Date:</label>
                        <input type="text" id="timeRange" name="timeRange" placeholder="e.g. 08:30 or 2024-05-10" required>
                    </div>

                    <button type="submit" class="search-btn">Find Flight</button>
                </form>

                <div id="flightInfo"></div>
            </div>
        </div>

        <div class="plane-wrapper">
            <div class="plane">
                <img src="/images/search.png" alt="Plane animation">
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const flightForm = document.getElementById("flightForm");
            const flightNumberInput = document.getElementById("flightNumber");
            const timeRangeInput = document.getElementById("timeRange");
            const flightInfoDiv = document.getElementById("flightInfo");

            flightForm.addEventListener("submit", async function (event) {
                event.preventDefault();
                const flightNumber = flightNumberInput.value.trim();
                const timeRange = timeRangeInput.value.trim();

                try {
                    const response = await fetch(`/getFlightInfo?flightNumber=${encodeURIComponent(flightNumber)}&timeRange=${encodeURIComponent(timeRange)}`);
                    if (!response.ok) {
                        throw new Error("Failed to retrieve flight information.");
                    }
                    const data = await response.json();
                    flightInfoDiv.style.display = "block";
                    flightInfoDiv.textContent = data;
                } catch (error) {
                    console.error(error);
                    flightInfoDiv.style.display = "block";
                    flightInfoDiv.textContent = "Error retrieving flight information.";
                }
            });
        });
    </script>
</body>
</html>