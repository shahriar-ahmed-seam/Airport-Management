<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Information</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p8.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .header-title {
            text-align: center;
            color: #F3C693;
            font-size: 36px;
            margin-top: 30px;
            margin-bottom: 20px;
            font-weight: bold;
        }

        .admin-container {
            display: flex;
            justify-content: center;
            padding: 10px 20px 40px 20px;
        }

        .admin-card {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .admin-avatar {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #F3C693;
            margin-bottom: 15px;
        }

        .admin-name {
            color: #F3C693;
            font-size: 28px;
            margin-bottom: 15px;
        }

        .admin-info-list {
            text-align: left;
            margin: 20px auto;
            max-width: 380px;
            background: rgba(255, 255, 255, 0.05);
            padding: 15px 20px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .admin-info-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            color: #f1f1f1;
            font-size: 16px;
        }

        .admin-info-row:last-child {
            border-bottom: none;
        }

        .admin-info-label {
            color: #bbb;
            font-weight: 500;
        }

        .action-btn {
            display: block;
            width: 100%;
            padding: 12px 10px;
            margin-top: 25px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            background-color: #F3C693;
            color: #222;
            transition: background-color 0.3s, transform 0.2s;
        }

        .action-btn:hover {
            background-color: #e5b37b;
            transform: translateY(-2px);
        }
    </style>
</head>
<body>
    <div class='bg'>
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About & Contact</a></li>
                    <li><a href='/management'>Management</a></li>
                    <li><a href='/logout'>Log Out</a></li>
                </ul>
            </nav>
        </div>

        <h1 class="header-title">Admin Information</h1>

        <div class="admin-container">
            <div class="admin-card">
                <img src="/images/img1.jpg" alt="Admin Profile" class="admin-avatar">
                <h2 class="admin-name">
                    <%= admin ? (admin.FIRST_NAME || admin.first_name || '') : '' %> <%= admin ? (admin.LAST_NAME || admin.last_name || '') : '' %>
                </h2>

                <div class="admin-info-list">
                    <div class="admin-info-row">
                        <span class="admin-info-label">Admin ID:</span>
                        <span><%= admin ? (admin.ID || admin.id || 'N/A') : 'N/A' %></span>
                    </div>
                    <% if (admin && (admin.SALARY || admin.salary || admin.Salary)) { %>
                    <div class="admin-info-row">
                        <span class="admin-info-label">Salary:</span>
                        <span>$<%= admin.SALARY || admin.salary || admin.Salary %></span>
                    </div>
                    <% } %>
                    <div class="admin-info-row">
                        <span class="admin-info-label">Email:</span>
                        <span><%= admin ? (admin.EMAIL || admin.email || 'N/A') : 'N/A' %></span>
                    </div>
                    <div class="admin-info-row">
                        <span class="admin-info-label">Address:</span>
                        <span><%= admin ? (admin.ADDRESS || admin.address || 'N/A') : 'N/A' %></span>
                    </div>
                </div>

                <a href="/management" class="action-btn">Go to Management Portal</a>
            </div>
        </div>
    </div>
</body>
</html>