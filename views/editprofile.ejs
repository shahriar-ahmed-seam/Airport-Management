<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Edit Profile</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url(/images/p3.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .edit-container {
            max-width: 580px;
            margin: 35px auto 40px auto;
            padding: 0 20px;
        }

        .edit-card {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 30px 35px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .edit-card h1 {
            color: #F3C693;
            font-size: 30px;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-row {
            margin-bottom: 18px;
        }

        .form-row label {
            display: block;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 6px;
        }

        .form-row input {
            width: 100%;
            padding: 11px 14px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
            font-size: 15px;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-row input:focus {
            border-color: #F3C693;
        }

        .btn-save {
            width: 100%;
            padding: 12px 0;
            margin-top: 10px;
            background-color: #007bff;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
        }

        .btn-save:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 15px;
            color: #F3C693;
            text-decoration: none;
            font-size: 15px;
        }

        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About & Contact</a></li>
                    <% if (locals.currentUser) { %>
                        <li><a href='/users'>My Profile</a></li>
                        <li><a href='/logout'>Log Out</a></li>
                    <% } else { %>
                        <li><a href='/login_reg'>Sign In / Register</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>

        <div class="edit-container">
            <div class="edit-card">
                <h1>Edit Passenger Profile</h1>
                <form action="/updateuser" method="POST">
                    <div class="form-row">
                        <label for="first_name">First Name</label>
                        <input type="text" id="first_name" name="first_name" placeholder="First Name" value="<%= user ? (user.FIRST_NAME || user.first_name || '') : '' %>" required>
                    </div>

                    <div class="form-row">
                        <label for="last_name">Last Name</label>
                        <input type="text" id="last_name" name="last_name" placeholder="Last Name" value="<%= user ? (user.LAST_NAME || user.last_name || '') : '' %>" required>
                    </div>

                    <div class="form-row">
                        <label for="age">Age</label>
                        <input type="number" id="age" name="age" placeholder="Age" value="<%= user ? (user.AGE || user.age || '') : '' %>" required>
                    </div>

                    <div class="form-row">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="example@email.com" value="<%= user ? (user.EMAIL || user.email || '') : '' %>" required>
                    </div>

                    <div class="form-row">
                        <label for="address">Address</label>
                        <input type="text" id="address" name="address" placeholder="Address" value="<%= user ? (user.ADDRESS || user.address || '') : '' %>" required>
                    </div>

                    <input type="hidden" name="id" value="<%= user ? (user.ID || user.id || '') : '' %>">

                    <button type="submit" class="btn-save">Save Profile</button>
                    <a href="/users" class="back-link">Cancel & Return to Profile</a>
                </form>
            </div>
        </div>
    </div>
</body>
</html>