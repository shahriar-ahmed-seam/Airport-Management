<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Home</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body, html {
            overflow-x: hidden;
            height: 100%;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/2.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow-x: hidden;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .hero-title-section {
            text-align: center;
            padding: 80px 20px 20px 20px;
        }

        .hero-title {
            font-size: 64px;
            color: #ffffff;
            letter-spacing: 2px;
            text-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
            margin-bottom: 10px;
        }

        .hero-subtitle {
            font-size: 22px;
            color: #F3C693;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
        }

        .plane-wrapper {
            position: relative;
            width: 100%;
            height: 160px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .plane {
            position: absolute;
            animation: flyAcross 12s linear infinite;
        }

        .plane img {
            width: 180px;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.5));
        }

        @keyframes flyAcross {
            0% {
                left: -200px;
                transform: scaleX(1);
            }
            49% {
                left: calc(100% + 50px);
                transform: scaleX(1);
            }
            50% {
                left: calc(100% + 50px);
                transform: scaleX(-1);
            }
            99% {
                left: -200px;
                transform: scaleX(-1);
            }
            100% {
                left: -200px;
                transform: scaleX(1);
            }
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About Us</a></li>
                    <li><a href='/contact'>Contact Us</a></li>
                    <li><a href='/login_reg'>Sign In / Register</a></li>
                    <li><a href='/admin_login'>Admin</a></li>
                </ul>
            </nav>
        </div>

        <div class="hero-title-section">
            <h1 class="hero-title">DHAKA AIRPORT</h1>
            <p class="hero-subtitle">Hazrat Shahjalal International Airport Management Portal</p>
        </div>

        <div class="plane-wrapper">
            <div class="plane">
                <img src="/images/search.png" alt="Flying Plane">
            </div>
        </div>
    </div>
    <script src="/js/script.js"></script>
</body>
</html>