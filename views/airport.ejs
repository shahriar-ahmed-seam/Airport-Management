<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Airport Search</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p2.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .page-title {
            margin: 30px 0 20px 0;
            font-size: 38px;
            text-align: center;
            color: #F3C693;
            font-weight: bold;
        }

        .search-wrapper {
            max-width: 600px;
            margin: 0 auto 30px auto;
            padding: 0 20px;
        }

        .search-bar-row {
            display: flex;
            gap: 10px;
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(8px);
            padding: 15px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
        }

        #searchInput {
            flex: 1;
            padding: 12px 15px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            font-size: 16px;
            outline: none;
        }

        #searchInput:focus {
            border-color: #F3C693;
        }

        .btn-search {
            background-color: #007bff;
            color: #fff;
            padding: 10px 22px;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .btn-search:hover {
            background-color: #0056b3;
        }

        .btn-refresh {
            background-color: #28a745;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .btn-refresh:hover {
            background-color: #218838;
        }

        #flightInfoContainer {
            max-width: 600px;
            margin: 0 auto 50px auto;
            padding: 0 20px;
        }

        .flight-info-card {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 25px 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .flight-info-card h3 {
            color: #F3C693;
            font-size: 24px;
            margin-bottom: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.15);
            padding-bottom: 12px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .info-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 12px 15px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .info-label {
            font-size: 13px;
            color: #aaa;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 17px;
            color: #ffffff;
            font-weight: 600;
        }

        .no-flights {
            text-align: center;
            color: #f87171;
            font-size: 18px;
            padding: 20px;
            background: rgba(0, 0, 0, 0.7);
            border-radius: 10px;
            border: 1px solid rgba(248, 113, 113, 0.3);
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About Us</a></li>
                    <li><a href='/contact'>Contact</a></li>
                </ul>
            </nav>
        </div>

        <h1 class="page-title">Airport Information Search</h1>

        <div class="search-wrapper">
            <div class="search-bar-row">
                <input type="text" id="searchInput" placeholder="Enter Airport Name (e.g. JFK, LHR, DXB)">
                <button id="searchButton" class="btn-search">Search</button>
                <button id="refreshButton" class="btn-refresh">Refresh</button>
            </div>
        </div>

        <div id="flightInfoContainer"></div>
    </div>

    <script>
        const searchInput = document.getElementById('searchInput');
        const searchButton = document.getElementById('searchButton');
        const refreshButton = document.getElementById('refreshButton');
        const flightInfoContainer = document.getElementById('flightInfoContainer');

        searchButton.addEventListener('click', function () {
            const airportName = searchInput.value.trim();
            if (!airportName) return;

            fetch(`/getplanes?airportName=${encodeURIComponent(airportName)}`)
                .then(response => response.json())
                .then(data => {
                    flightInfoContainer.innerHTML = '';
                    if (data && data.length > 0) {
                        const card = document.createElement('div');
                        card.className = 'flight-info-card';
                        card.innerHTML = `
                            <h3>${data[1] || 'Airport Details'}</h3>
                            <div class="info-grid">
                                <div class="info-item">
                                    <div class="info-label">Flight Number</div>
                                    <div class="info-value">${data[0] || 'N/A'}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Flight ID</div>
                                    <div class="info-value">${data[2] || 'N/A'}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">City</div>
                                    <div class="info-value">${data[3] || 'N/A'}</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Capacity</div>
                                    <div class="info-value">${data[4] || 'N/A'}</div>
                                </div>
                                <div class="info-item" style="grid-column: 1 / -1;">
                                    <div class="info-label">Country</div>
                                    <div class="info-value">${data[5] || 'N/A'}</div>
                                </div>
                            </div>
                        `;
                        flightInfoContainer.appendChild(card);
                    } else {
                        flightInfoContainer.innerHTML = '<div class="no-flights">No airport records found.</div>';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    flightInfoContainer.innerHTML = '<div class="no-flights">Error fetching airport information.</div>';
                });
        });

        refreshButton.addEventListener('click', function () {
            location.reload();
        });
    </script>
</body>
</html>