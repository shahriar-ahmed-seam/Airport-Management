<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Email Verification</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p4.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .verify-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
        }

        .verify-card {
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 40px;
            max-width: 480px;
            width: 100%;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .verify-card h1 {
            color: #ffffff;
            font-size: 30px;
            margin-bottom: 15px;
        }

        .id-badge {
            background: rgba(243, 198, 147, 0.15);
            border: 1px solid #F3C693;
            color: #F3C693;
            padding: 12px;
            border-radius: 8px;
            font-size: 17px;
            margin-bottom: 20px;
        }

        .verify-card p {
            color: #e0e0e0;
            font-size: 15px;
            margin-bottom: 25px;
            line-height: 1.5;
        }

        .verify-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .verify-input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            font-size: 18px;
            text-align: center;
            letter-spacing: 2px;
            outline: none;
            transition: border-color 0.3s;
        }

        .verify-input:focus {
            border-color: #F3C693;
        }

        .verify-btn {
            background-color: #007bff;
            color: #fff;
            padding: 12px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .verify-btn:hover {
            background-color: #0056b3;
        }

        #popup {
            display: none;
            margin-top: 15px;
            padding: 12px;
            border-radius: 6px;
            font-size: 14px;
        }

        .popup-error {
            background: rgba(220, 53, 69, 0.8);
            color: #fff;
        }

        .popup-success {
            background: rgba(40, 167, 69, 0.8);
            color: #fff;
        }
    </style>
</head>
<body>
    <div class='bg'>
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About Us</a></li>
                    <li><a href='/contact'>Contact</a></li>
                </ul>
            </nav>
        </div>

        <div class="verify-container">
            <div class="verify-card">
                <h1>Email Verification</h1>
                <% if (typeof newId !== 'undefined' && newId) { %>
                    <div class="id-badge">
                        Your Login ID: <strong><%= newId %></strong>
                    </div>
                <% } %>
                <p>A verification code has been sent to your email. Please enter it below to activate your account.</p>
                <form id="verificationForm" class="verify-form">
                    <input type="text" id="verificationCode" class="verify-input" placeholder="Enter Code" required>
                    <button type="submit" id="button" class="verify-btn">Verify Account</button>
                </form>
                <div id="popup"></div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('verificationForm').addEventListener('submit', function (event) {
            event.preventDefault();
            const userEnteredCode = document.getElementById('verificationCode').value;
            const popup = document.getElementById('popup');

            fetch('/verify-code', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ code: userEnteredCode })
            })
            .then(response => response.json())
            .then(data => {
                popup.style.display = 'block';
                if (data.valid) {
                    popup.className = 'popup-success';
                    popup.innerText = 'Account verified successfully! Logging you in...';
                    setTimeout(function () {
                        window.location.href = data.autoLogin ? '/users' : '/login_reg';
                    }, 1500);
                } else {
                    popup.className = 'popup-error';
                    popup.innerText = 'Invalid code. Please try again.';
                }
            })
            .catch(error => {
                console.error('Error:', error);
                popup.style.display = 'block';
                popup.className = 'popup-error';
                popup.innerText = 'Verification failed. Please try again.';
            });
        });
    </script>
</body>
</html>