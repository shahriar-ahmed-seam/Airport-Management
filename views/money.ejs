<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Airport Management - Financial Statistics</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg {
            min-height: 100vh;
            width: 100%;
            background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/images/p8.jpg);
            background-position: center;
            background-size: cover;
            background-attachment: fixed;
            position: relative;
        }

        .navigationBar {
            background-color: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            padding: 15px 50px;
        }

        .navigationBar a {
            text-decoration: none;
            color: rgb(150, 164, 210);
            font-size: 26px;
            font-weight: bold;
        }

        nav {
            flex: 1;
            text-align: right;
        }

        nav ul {
            display: inline-block;
            list-style: none;
        }

        nav ul li {
            display: inline-block;
            margin-left: 30px;
        }

        nav ul li a {
            text-decoration: none;
            font-size: 18px;
            color: rgb(243, 242, 242);
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #F3C693;
        }

        .finance-wrapper {
            max-width: 600px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .finance-card {
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            text-align: center;
        }

        .finance-card h1 {
            color: #ffffff;
            font-size: 32px;
            margin-bottom: 30px;
        }

        .metric-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 18px 25px;
            margin-bottom: 20px;
            transition: transform 0.2s, border-color 0.2s;
        }

        .metric-row:hover {
            transform: translateX(4px);
            border-color: #F3C693;
        }

        .metric-label {
            color: #F3C693;
            font-size: 20px;
            font-weight: 600;
        }

        .metric-value {
            font-size: 24px;
            font-weight: bold;
            color: #ffffff;
        }

        .value-profit {
            color: #4ade80;
        }

        .value-credit {
            color: #60a5fa;
        }

        .value-debit {
            color: #f87171;
        }

        .back-btn {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 25px;
            background-color: #F3C693;
            color: #222;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: background 0.3s;
        }

        .back-btn:hover {
            background-color: #e5b37b;
        }
    </style>
</head>
<body>
    <div class="bg">
        <div class="navigationBar">
            <div>
                <a href='/'>DHAKA AIRPORT</a>
            </div>
            <nav>
                <ul id='MenuItems'>
                    <li><a href='/'>Home</a></li>
                    <li><a href='/service'>Services</a></li>
                    <li><a href='/contact'>About & Contact</a></li>
                    <% if (locals.currentAdmin) { %>
                        <li><a href='/management'>Management</a></li>
                        <li><a href='/logout'>Log Out</a></li>
                    <% } else { %>
                        <li><a href='/admin_login'>Admin</a></li>
                    <% } %>
                </ul>
            </nav>
        </div>

        <div class="finance-wrapper">
            <div class="finance-card">
                <h1>Financial Statistics</h1>

                <div class="metric-row">
                    <span class="metric-label">Total Credit</span>
                    <span class="metric-value value-credit">$<%= credit %></span>
                </div>

                <div class="metric-row">
                    <span class="metric-label">Total Debit</span>
                    <span class="metric-value value-debit">$<%= debit %></span>
                </div>

                <div class="metric-row">
                    <span class="metric-label">Net Profit</span>
                    <span class="metric-value value-profit">$<%= profit %></span>
                </div>

                <a href="/management" class="back-btn">Back to Management</a>
            </div>
        </div>
    </div>
</body>
</html>
